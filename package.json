{
  "name": "crypto-themes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build": "vite build --config site/vite.config.ts",
    "preview": "vite preview --config site/vite.config.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "deploy": "bun run build && bun x wrangler@latest deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "solid-js": "1.9.19"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vite-plugin-solid": "2.11.16"
  }
}
